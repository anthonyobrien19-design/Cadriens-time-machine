<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing from this app is ever copied to Google's cloud backup. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
</data-extraction-rules>
